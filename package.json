{
  "name": "pi-profiler",
  "version": "0.1.1",
  "type": "module",
  "description": "Profiler de execução em tempo real para o Pi Coding Agent com trilha JSONL e TUI standalone",
  "keywords": [
    "pi-package",
    "pi",
    "profiler",
    "observability",
    "tui"
  ],
  "license": "MIT",
  "bin": {
    "pi-profiler": "./dist/bin/pi-profiler.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"pi-profiler.tests/*.test.mjs\"",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "dist",
    "index.ts",
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
